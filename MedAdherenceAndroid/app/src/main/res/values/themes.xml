<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app picks Light or Dark at start-up (system setting or the patient's choice in Settings). -->
    <style name="AppTheme.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#0D9488</item>
        <item name="android:colorPrimaryDark">#0D9488</item>
        <item name="android:colorAccent">#0D9488</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#5EEAD4</item>
        <item name="android:colorPrimaryDark">#5EEAD4</item>
        <item name="android:colorAccent">#5EEAD4</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
    </style>

    <color name="bg_light">#F8FAFC</color>
    <color name="surface_light">#FFFFFF</color>
    <color name="bg_dark">#0B1220</color>
    <color name="surface_dark">#131C2B</color>
</resources>

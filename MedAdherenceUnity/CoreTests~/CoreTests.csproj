<!--
  Runs the engine-free core logic and its NUnit tests with plain .NET, so they can be checked
  without Unity (e.g. in CI):  dotnet test MedAdherenceUnity/CoreTests~
  Unity ignores folders ending in "~", so this project never shows up inside the editor.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/MedAdherence/Scripts/Core/**/*.cs" />
    <Compile Include="../Assets/MedAdherence/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- NUnit 3 matches the classic Assert API used by Unity's Test Framework. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
